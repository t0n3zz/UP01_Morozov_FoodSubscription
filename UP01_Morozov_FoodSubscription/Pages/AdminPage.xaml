<Page x:Class="UP01_Morozov_FoodSubscription.Pages.AdminPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Панель администратора"
      Background="{DynamicResource BackgroundBrush}">

    <Grid>
        <Border Style="{DynamicResource Card}"
                Width="560"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
            <StackPanel>
                <TextBlock Style="{DynamicResource TitleText}"
                           Text="Панель администратора" />

                <TextBlock x:Name="TbWelcome"
                           Style="{DynamicResource SubtitleText}"
                           HorizontalAlignment="Center" />

                <TextBlock x:Name="TbStats"
                           HorizontalAlignment="Center"
                           Margin="8,0,8,12"
                           Foreground="{DynamicResource MutedTextBrush}" />

                <Button Content="Пользователи"
                        MinWidth="320"
                        ToolTip="Просмотр и редактирование таблицы пользователей"
                        Click="BtnUsers_Click" />

                <Button Content="Категории продуктовых наборов"
                        MinWidth="320"
                        ToolTip="Просмотр и редактирование таблицы категорий"
                        Click="BtnCategories_Click" />

                <Button Content="Подписки"
                        MinWidth="320"
                        ToolTip="Просмотр и редактирование таблицы подписок"
                        Click="BtnSubscriptions_Click" />

                <Button Content="Диаграммы и отчёты"
                        MinWidth="320"
                        ToolTip="Диаграмма расходов и экспорт отчётов в Word, PDF и Excel"
                        Click="BtnDiagramm_Click" />

                <Button Content="Сменить пароль"
                        MinWidth="320"
                        Style="{DynamicResource SecondaryButton}"
                        ToolTip="Изменить пароль учётной записи"
                        Click="BtnChangePassword_Click" />

                <Button Content="Выйти из учётной записи"
                        MinWidth="320"
                        Style="{DynamicResource DangerButton}"
                        ToolTip="Завершить сеанс и вернуться к авторизации"
                        Click="BtnLogout_Click" />
            </StackPanel>
        </Border>
    </Grid>
</Page>
