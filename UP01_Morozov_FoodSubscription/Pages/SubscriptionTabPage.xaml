<Page x:Class="UP01_Morozov_FoodSubscription.Pages.SubscriptionTabPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Таблица «Подписки»"
      Background="{DynamicResource BackgroundBrush}"
      IsVisibleChanged="Page_IsVisibleChanged">

    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{DynamicResource Card}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0">
                    <TextBox x:Name="TbSearch"
                             ToolTip="Поиск по названию набора и Ф.И.О. пользователя"
                             TextChanged="TbSearch_TextChanged" />
                    <TextBlock x:Name="PhSearch"
                               Style="{DynamicResource PlaceholderText}"
                               Text="Поиск по набору или Ф.И.О."
                               MouseLeftButtonUp="PhSearch_MouseLeftButtonUp" />
                </Grid>

                <ComboBox x:Name="CmbCategory" Grid.Column="1"
                          DisplayMemberPath="Name"
                          ToolTip="Фильтр по категории"
                          SelectionChanged="Filter_SelectionChanged" />

                <ComboBox x:Name="CmbUser" Grid.Column="2"
                          DisplayMemberPath="FIO"
                          ToolTip="Фильтр по пользователю"
                          SelectionChanged="Filter_SelectionChanged" />

                <ComboBox x:Name="CmbSort" Grid.Column="3" SelectedIndex="0"
                          ToolTip="Сортировка списка подписок"
                          SelectionChanged="Filter_SelectionChanged">
                    <ComboBoxItem Content="Сначала новые" />
                    <ComboBoxItem Content="Сначала старые" />
                    <ComboBoxItem Content="Сумма по убыванию" />
                    <ComboBoxItem Content="Сумма по возрастанию" />
                    <ComboBoxItem Content="Название (А-Я)" />
                </ComboBox>

                <Button Grid.Column="4" Content="Сбросить фильтры"
                        MinWidth="170"
                        Style="{DynamicResource SecondaryButton}"
                        ToolTip="Очистить поиск, фильтры и сортировку"
                        Click="BtnClear_Click" />
            </Grid>
        </Border>

        <DataGrid x:Name="DgSubscriptions" Grid.Row="1">
            <DataGrid.Columns>
                <DataGridTextColumn Header="№"           Binding="{Binding ID}" Width="60" />
                <DataGridTextColumn Header="Дата"        Binding="{Binding Date, StringFormat=dd.MM.yyyy}" Width="110" />
                <DataGridTextColumn Header="Пользователь" Binding="{Binding User.FIO}" Width="*" />
                <DataGridTextColumn Header="Категория"   Binding="{Binding Category.Name}" Width="170" />
                <DataGridTextColumn Header="Набор"       Binding="{Binding Name}" Width="*" />
                <DataGridTextColumn Header="Кол-во"      Binding="{Binding Num}" Width="80" />
                <DataGridTextColumn Header="Цена, руб."  Binding="{Binding Price, StringFormat=N2}" Width="110" />
                <DataGridTextColumn Header="Итого, руб." Binding="{Binding Total, StringFormat=N2}" Width="120" />
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center">
            <Button Content="Добавить" ToolTip="Добавить новую подписку" Click="BtnAdd_Click" />
            <Button Content="Редактировать" ToolTip="Изменить выбранную подписку" Click="BtnEdit_Click" />
            <Button Content="Удалить" Style="{DynamicResource DangerButton}"
                    ToolTip="Удалить выбранную подписку" Click="BtnDelete_Click" />
            <Button Content="Назад" Style="{DynamicResource SecondaryButton}"
                    ToolTip="Вернуться в панель администратора" Click="BtnBack_Click" />
        </StackPanel>

        <TextBlock x:Name="TbCount" Grid.Row="3" Margin="12,4"
                   Foreground="{DynamicResource MutedTextBrush}" />
    </Grid>
</Page>
