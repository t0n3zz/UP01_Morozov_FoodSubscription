<Page x:Class="UP01_Morozov_FoodSubscription.Pages.UsersTabPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Таблица «Пользователи»"
      Background="{DynamicResource BackgroundBrush}"
      IsVisibleChanged="Page_IsVisibleChanged">

    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{DynamicResource Card}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0">
                    <TextBox x:Name="TbSearch"
                             ToolTip="Поиск по Ф.И.О. и логину"
                             TextChanged="TbSearch_TextChanged" />
                    <TextBlock x:Name="PhSearch"
                               Style="{DynamicResource PlaceholderText}"
                               Text="Поиск по Ф.И.О. или логину"
                               MouseLeftButtonUp="PhSearch_MouseLeftButtonUp" />
                </Grid>

                <ComboBox x:Name="CmbRole" Grid.Column="1" SelectedIndex="0"
                          ToolTip="Фильтр по роли пользователя"
                          SelectionChanged="Filter_SelectionChanged">
                    <ComboBoxItem Content="Все роли" />
                    <ComboBoxItem Content="Администратор" />
                    <ComboBoxItem Content="Пользователь" />
                </ComboBox>

                <ComboBox x:Name="CmbSort" Grid.Column="2" SelectedIndex="0"
                          ToolTip="Сортировка списка пользователей"
                          SelectionChanged="Filter_SelectionChanged">
                    <ComboBoxItem Content="Ф.И.О. (А-Я)" />
                    <ComboBoxItem Content="Ф.И.О. (Я-А)" />
                    <ComboBoxItem Content="Сумма подписок по убыванию" />
                    <ComboBoxItem Content="Сумма подписок по возрастанию" />
                </ComboBox>

                <Button Grid.Column="3" Content="Сбросить фильтры"
                        MinWidth="170"
                        Style="{DynamicResource SecondaryButton}"
                        ToolTip="Очистить поиск, фильтр и сортировку"
                        Click="BtnClear_Click" />
            </Grid>
        </Border>

        <DataGrid x:Name="DgUsers" Grid.Row="1">
            <DataGrid.Columns>
                <DataGridTextColumn Header="№"       Binding="{Binding ID}" Width="60" />
                <DataGridTextColumn Header="Ф.И.О."  Binding="{Binding FIO}" Width="*" />
                <DataGridTextColumn Header="Логин"   Binding="{Binding Login}" Width="160" />
                <DataGridTextColumn Header="Роль"    Binding="{Binding Role}" Width="160" />
                <DataGridTextColumn Header="Подписок" Binding="{Binding Subscription.Count}" Width="100" />
                <DataGridTextColumn Header="Сумма, руб." Binding="{Binding TotalSum, StringFormat=N2}" Width="140" />
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center">
            <Button Content="Добавить"
                    ToolTip="Добавить нового пользователя"
                    Click="BtnAdd_Click" />
            <Button Content="Редактировать"
                    ToolTip="Изменить данные выбранного пользователя"
                    Click="BtnEdit_Click" />
            <Button Content="Удалить"
                    Style="{DynamicResource DangerButton}"
                    ToolTip="Удалить выбранного пользователя вместе с его подписками"
                    Click="BtnDelete_Click" />
            <Button Content="Назад"
                    Style="{DynamicResource SecondaryButton}"
                    ToolTip="Вернуться в панель администратора"
                    Click="BtnBack_Click" />
        </StackPanel>

        <TextBlock x:Name="TbCount" Grid.Row="3" Margin="12,4"
                   Foreground="{DynamicResource MutedTextBrush}" />
    </Grid>
</Page>
