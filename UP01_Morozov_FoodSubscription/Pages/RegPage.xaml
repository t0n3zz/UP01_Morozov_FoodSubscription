<Page x:Class="UP01_Morozov_FoodSubscription.Pages.RegPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Регистрация"
      Background="{DynamicResource BackgroundBrush}">

    <Grid>
        <Border Style="{DynamicResource Card}"
                Width="500"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Style="{DynamicResource TitleText}"
                           Text="Регистрация пользователя" />

                <Grid Grid.Row="1">
                    <TextBox x:Name="TbFio"
                             MaxLength="150"
                             ToolTip="Фамилия, имя и отчество на кириллице, например: Морозов Александр Владимирович"
                             TextChanged="TbFio_TextChanged" />
                    <TextBlock x:Name="PhFio"
                               Style="{DynamicResource PlaceholderText}"
                               Text="Фамилия Имя Отчество"
                               MouseLeftButtonUp="PhFio_MouseLeftButtonUp" />
                </Grid>

                <Grid Grid.Row="2">
                    <TextBox x:Name="TbLogin"
                             MaxLength="50"
                             ToolTip="От 3 до 50 символов: латинские буквы, цифры, знак подчёркивания"
                             TextChanged="TbLogin_TextChanged" />
                    <TextBlock x:Name="PhLogin"
                               Style="{DynamicResource PlaceholderText}"
                               Text="Придумайте логин"
                               MouseLeftButtonUp="PhLogin_MouseLeftButtonUp" />
                </Grid>

                <Grid Grid.Row="3">
                    <PasswordBox x:Name="PbPassword"
                                 MaxLength="30"
                                 ToolTip="Не менее 6 символов: заглавная и строчная буквы, цифра и спецсимвол"
                                 PasswordChanged="PbPassword_PasswordChanged" />
                    <TextBlock x:Name="PhPassword"
                               Style="{DynamicResource PlaceholderText}"
                               Text="Придумайте пароль"
                               MouseLeftButtonUp="PhPassword_MouseLeftButtonUp" />
                </Grid>

                <Grid Grid.Row="4">
                    <PasswordBox x:Name="PbConfirm"
                                 MaxLength="30"
                                 ToolTip="Повторите введённый пароль"
                                 PasswordChanged="PbConfirm_PasswordChanged" />
                    <TextBlock x:Name="PhConfirm"
                               Style="{DynamicResource PlaceholderText}"
                               Text="Повторите пароль"
                               MouseLeftButtonUp="PhConfirm_MouseLeftButtonUp" />
                </Grid>

                <Grid Grid.Row="5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Label Grid.Column="0" Content="Роль:" />
                    <ComboBox x:Name="CmbRole"
                              Grid.Column="1"
                              SelectedIndex="0"
                              ToolTip="Выберите роль учётной записи">
                        <ComboBoxItem Content="Пользователь" />
                        <ComboBoxItem Content="Администратор" />
                    </ComboBox>
                </Grid>

                <TextBlock Grid.Row="6"
                           Margin="8"
                           Foreground="{DynamicResource MutedTextBrush}"
                           Text="Пароль должен содержать не менее 6 символов, заглавную и строчную буквы, цифру и специальный символ." />

                <StackPanel Grid.Row="7" Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button x:Name="BtnReg"
                            Content="Зарегистрироваться"
                            MinWidth="190"
                            ToolTip="Создать учётную запись"
                            Click="BtnReg_Click" />
                    <Button x:Name="BtnBack"
                            Content="Назад"
                            Style="{DynamicResource SecondaryButton}"
                            ToolTip="Вернуться к авторизации"
                            Click="BtnBack_Click" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Page>
