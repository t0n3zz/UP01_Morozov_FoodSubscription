<Page x:Class="UP01_Morozov_FoodSubscription.Pages.ChangePasswordPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Смена пароля"
      Background="{DynamicResource BackgroundBrush}">

    <Grid>
        <Border Style="{DynamicResource Card}"
                Width="480"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Style="{DynamicResource TitleText}"
                           Text="Смена пароля" />

                <Grid Grid.Row="1">
                    <TextBox x:Name="TbLogin"
                             MaxLength="50"
                             ToolTip="Логин учётной записи, пароль которой меняется"
                             TextChanged="TbLogin_TextChanged" />
                    <TextBlock x:Name="PhLogin"
                               Style="{DynamicResource PlaceholderText}"
                               Text="Логин"
                               MouseLeftButtonUp="PhLogin_MouseLeftButtonUp" />
                </Grid>

                <Grid Grid.Row="2">
                    <PasswordBox x:Name="PbOld"
                                 MaxLength="30"
                                 ToolTip="Действующий пароль"
                                 PasswordChanged="PbOld_PasswordChanged" />
                    <TextBlock x:Name="PhOld"
                               Style="{DynamicResource PlaceholderText}"
                               Text="Старый пароль"
                               MouseLeftButtonUp="PhOld_MouseLeftButtonUp" />
                </Grid>

                <Grid Grid.Row="3">
                    <PasswordBox x:Name="PbNew"
                                 MaxLength="30"
                                 ToolTip="Не менее 6 символов: заглавная и строчная буквы, цифра и спецсимвол"
                                 PasswordChanged="PbNew_PasswordChanged" />
                    <TextBlock x:Name="PhNew"
                               Style="{DynamicResource PlaceholderText}"
                               Text="Новый пароль"
                               MouseLeftButtonUp="PhNew_MouseLeftButtonUp" />
                </Grid>

                <Grid Grid.Row="4">
                    <PasswordBox x:Name="PbConfirm"
                                 MaxLength="30"
                                 ToolTip="Повторите новый пароль"
                                 PasswordChanged="PbConfirm_PasswordChanged" />
                    <TextBlock x:Name="PhConfirm"
                               Style="{DynamicResource PlaceholderText}"
                               Text="Повторите новый пароль"
                               MouseLeftButtonUp="PhConfirm_MouseLeftButtonUp" />
                </Grid>

                <TextBlock Grid.Row="5"
                           Margin="8"
                           Foreground="{DynamicResource MutedTextBrush}"
                           Text="Новый пароль не должен совпадать со старым." />

                <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button x:Name="BtnSave"
                            Content="Сохранить изменения"
                            MinWidth="200"
                            ToolTip="Сохранить новый пароль"
                            Click="BtnSave_Click" />
                    <Button x:Name="BtnBack"
                            Content="Назад"
                            Style="{DynamicResource SecondaryButton}"
                            ToolTip="Вернуться к авторизации"
                            Click="BtnBack_Click" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Page>
