<Page x:Class="UP01_Morozov_FoodSubscription.Pages.AddSubscriptionPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Добавление подписки"
      Background="{DynamicResource BackgroundBrush}">

    <Grid>
        <Border Style="{DynamicResource Card}"
                Width="560"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="TbHeader"
                           Grid.Row="0" Grid.ColumnSpan="2"
                           Style="{DynamicResource TitleText}"
                           Text="Добавление подписки" />

                <Label Grid.Row="1" Grid.Column="0" Content="Пользователь:" />
                <ComboBox x:Name="CmbUser" Grid.Row="1" Grid.Column="1"
                          DisplayMemberPath="FIO"
                          ToolTip="Пользователь, оформивший подписку" />

                <Label Grid.Row="2" Grid.Column="0" Content="Категория:" />
                <ComboBox x:Name="CmbCategory" Grid.Row="2" Grid.Column="1"
                          DisplayMemberPath="Name"
                          ToolTip="Категория продуктового набора" />

                <Label Grid.Row="3" Grid.Column="0" Content="Название набора:" />
                <TextBox x:Name="TbName" Grid.Row="3" Grid.Column="1" MaxLength="150"
                         ToolTip="Например: Бокс «Фермерские овощи», 5 кг" />

                <Label Grid.Row="4" Grid.Column="0" Content="Количество:" />
                <TextBox x:Name="TbNum" Grid.Row="4" Grid.Column="1" MaxLength="3"
                         ToolTip="Количество наборов в доставке: от 1 до 100"
                         PreviewTextInput="TbNum_PreviewTextInput" />

                <Label Grid.Row="5" Grid.Column="0" Content="Цена, руб.:" />
                <TextBox x:Name="TbPrice" Grid.Row="5" Grid.Column="1" MaxLength="9"
                         ToolTip="Стоимость одного набора: от 0 до 100 000 руб."
                         PreviewTextInput="TbPrice_PreviewTextInput" />

                <Label Grid.Row="6" Grid.Column="0" Content="Дата оформления:" />
                <DatePicker x:Name="DpDate" Grid.Row="6" Grid.Column="1"
                            ToolTip="Дата оформления подписки (не позднее сегодняшнего дня)" />

                <StackPanel Grid.Row="7" Grid.ColumnSpan="2"
                            Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Content="Сохранить" ToolTip="Сохранить подписку" Click="BtnSave_Click" />
                    <Button Content="Очистить" Style="{DynamicResource SecondaryButton}"
                            ToolTip="Очистить все поля формы" Click="BtnClear_Click" />
                    <Button Content="Назад" Style="{DynamicResource SecondaryButton}"
                            ToolTip="Вернуться к таблице подписок" Click="BtnBack_Click" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Page>
