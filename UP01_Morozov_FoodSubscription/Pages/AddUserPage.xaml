<Page x:Class="UP01_Morozov_FoodSubscription.Pages.AddUserPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Добавление пользователя"
      Background="{DynamicResource BackgroundBrush}">

    <Grid>
        <Border Style="{DynamicResource Card}"
                Width="520"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock x:Name="TbHeader" Grid.Row="0"
                           Style="{DynamicResource TitleText}"
                           Text="Добавление пользователя" />

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Label Grid.Column="0" Content="Ф.И.О.:" />
                    <TextBox x:Name="TbFio" Grid.Column="1" MaxLength="150"
                             ToolTip="Фамилия, имя и отчество на кириллице" />
                </Grid>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Label Grid.Column="0" Content="Логин:" />
                    <TextBox x:Name="TbLogin" Grid.Column="1" MaxLength="50"
                             ToolTip="От 3 до 50 символов: латиница, цифры, знак подчёркивания" />
                </Grid>

                <Grid Grid.Row="3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Label Grid.Column="0" Content="Пароль:" />
                    <PasswordBox x:Name="PbPassword" Grid.Column="1" MaxLength="30"
                                 ToolTip="При редактировании оставьте поле пустым, чтобы сохранить текущий пароль" />
                </Grid>

                <Grid Grid.Row="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Label Grid.Column="0" Content="Роль:" />
                    <ComboBox x:Name="CmbRole" Grid.Column="1" SelectedIndex="0"
                              ToolTip="Роль учётной записи">
                        <ComboBoxItem Content="Пользователь" />
                        <ComboBoxItem Content="Администратор" />
                    </ComboBox>
                </Grid>

                <Grid Grid.Row="5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Label Grid.Column="0" Content="Фотография:" />
                    <TextBox x:Name="TbPhoto" Grid.Column="1" MaxLength="255"
                             ToolTip="Имя файла из каталога res, например user1.png" />
                </Grid>

                <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Content="Сохранить"
                            ToolTip="Сохранить данные пользователя"
                            Click="BtnSave_Click" />
                    <Button Content="Очистить"
                            Style="{DynamicResource SecondaryButton}"
                            ToolTip="Очистить все поля формы"
                            Click="BtnClear_Click" />
                    <Button Content="Назад"
                            Style="{DynamicResource SecondaryButton}"
                            ToolTip="Вернуться к таблице пользователей"
                            Click="BtnBack_Click" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Page>
