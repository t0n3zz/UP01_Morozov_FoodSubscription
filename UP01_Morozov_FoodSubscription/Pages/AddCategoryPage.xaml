<Page x:Class="UP01_Morozov_FoodSubscription.Pages.AddCategoryPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Добавление категории"
      Background="{DynamicResource BackgroundBrush}">

    <Grid>
        <Border Style="{DynamicResource Card}"
                Width="480"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
            <StackPanel>
                <TextBlock x:Name="TbHeader"
                           Style="{DynamicResource TitleText}"
                           Text="Добавление категории" />

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Label Grid.Column="0" Content="Название:" />
                    <TextBox x:Name="TbName" Grid.Column="1" MaxLength="100"
                             ToolTip="Название категории продуктовых наборов, например: Молочные продукты" />
                </Grid>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Content="Сохранить" ToolTip="Сохранить категорию" Click="BtnSave_Click" />
                    <Button Content="Очистить" Style="{DynamicResource SecondaryButton}"
                            ToolTip="Очистить поле ввода" Click="BtnClear_Click" />
                    <Button Content="Назад" Style="{DynamicResource SecondaryButton}"
                            ToolTip="Вернуться к таблице категорий" Click="BtnBack_Click" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Page>
