<Window x:Class="UP01_Morozov_FoodSubscription.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Онлайн-сервис подписки на продукты питания"
        Height="700" Width="1150"
        MinHeight="600" MinWidth="1000"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BackgroundBrush}"
        Loaded="Window_Loaded"
        Closing="Window_Closing">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="45" />
            <RowDefinition Height="*" />
            <RowDefinition Height="45" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource HeaderBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button x:Name="BtnBack"
                        Grid.Column="0"
                        Content="← Назад"
                        Height="32" MinWidth="110" Margin="6,0"
                        Visibility="Collapsed"
                        ToolTip="Вернуться на предыдущую страницу"
                        Click="BtnBack_Click" />

                <TextBlock x:Name="TbPageTitle"
                           Grid.Column="1"
                           Text="Авторизация"
                           FontSize="17" FontWeight="Bold"
                           Foreground="{DynamicResource TextOnPrimaryBrush}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button x:Name="BtnTheme"
                            Content="Тёмная тема"
                            Height="32" MinWidth="150" Margin="6,0"
                            ToolTip="Переключить оформление приложения"
                            Click="BtnTheme_Click" />
                    <Button x:Name="BtnExit"
                            Content="Выход"
                            Style="{DynamicResource DangerButton}"
                            Height="32" MinWidth="100" Margin="6,0"
                            ToolTip="Закрыть приложение"
                            Click="BtnExit_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <Frame x:Name="MainFrame"
               Grid.Row="1"
               NavigationUIVisibility="Hidden"
               HorizontalAlignment="Stretch"
               VerticalAlignment="Stretch"
               Navigated="MainFrame_Navigated" />

        <Border Grid.Row="2" Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="TbUserInfo"
                           Grid.Column="0"
                           Margin="12,0"
                           Text="Пользователь не авторизован"
                           Foreground="{DynamicResource MutedTextBrush}" />

                <TextBlock x:Name="TbDateTime"
                           Grid.Column="1"
                           Margin="12,0"
                           HorizontalAlignment="Right"
                           Foreground="{DynamicResource MutedTextBrush}" />
            </Grid>
        </Border>
    </Grid>
</Window>
